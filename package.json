{
  "name": "easygeo",
  "productName": "EasyGeo",
  "version": "0.3.2",
  "description": "Géométrie dynamique moderne pour le collège",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",

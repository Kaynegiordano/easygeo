    "app": "vite build && electron .",
    "dist": "tsc --noEmit && vite build && electron-builder --config electron-builder.json"
  },
  "dependencies": {
    "mathjs": "^15.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "author": "Kane"
}
